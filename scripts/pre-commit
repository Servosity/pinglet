#!/bin/bash
# Pre-commit hook: block PII and secrets in tracked files
# Install: bash scripts/install-hooks.sh

# Case-insensitive patterns
PII_PATTERNS=(
    '/Users/[a-zA-Z]'              # macOS personal home directory paths
    '/home/[a-zA-Z]'               # Linux home directory paths
    'xoxp-[0-9]'                   # Slack user tokens
    'xoxb-[0-9]'                   # Slack bot tokens
    'xoxs-[0-9]'                   # Slack session tokens
    'xapp-[0-9]'                   # Slack app tokens
    'sk-ant-[a-zA-Z0-9]'           # Anthropic API keys
    'ghp_[a-zA-Z0-9]'              # GitHub personal access tokens
    'gho_[a-zA-Z0-9]'              # GitHub OAuth tokens
    'SLACK_USER_TOKEN=xox'         # Actual token assignment
)

# Case-sensitive patterns (must match exact case)
CASE_SENSITIVE_PATTERNS=(
    'D[A-Z0-9]{8,}'               # Slack DM channel IDs (D + 8+ uppercase alphanum)
)

# Files that are allowed to contain these patterns
ALLOW_FILES=(
    'scripts/pre-commit'
    '.gitleaks.toml'
    '.env.example'
)

failed=0

# Get list of staged files
staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$staged_files" ]; then
    exit 0
fi

for file in $staged_files; do
    # Skip allowed files
    skip=0
    for allow in "${ALLOW_FILES[@]}"; do
        if [ "$file" = "$allow" ]; then
            skip=1
            break
        fi
    done
    if [ "$skip" -eq 1 ]; then
        continue
    fi

    diff_output=$(git diff --cached -U0 -- "$file" | grep -E "^\+" | grep -v "^+++")

    for pattern in "${PII_PATTERNS[@]}"; do
        matches=$(echo "$diff_output" | grep -iE "$pattern" || true)
        if [ -n "$matches" ]; then
            echo "BLOCKED: PII pattern '$pattern' found in $file:"
            echo "$matches" | head -5
            echo ""
            failed=1
        fi
    done

    for pattern in "${CASE_SENSITIVE_PATTERNS[@]}"; do
        matches=$(echo "$diff_output" | grep -E "$pattern" || true)
        if [ -n "$matches" ]; then
            echo "BLOCKED: PII pattern '$pattern' found in $file:"
            echo "$matches" | head -5
            echo ""
            failed=1
        fi
    done
done

if [ "$failed" -eq 1 ]; then
    echo "Commit rejected. Remove personal paths/tokens from staged files."
    echo "Use environment variables or gitignored config files instead."
    exit 1
fi

exit 0
