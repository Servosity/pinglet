<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pinglet.healthcheck</string>

    <key>ProgramArguments</key>
    <array>
        <string>/path/to/pinglet/venv/bin/python</string>
        <string>/path/to/pinglet/pinglet.py</string>
        <string>--healthcheck</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/path/to/pinglet</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>20</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/path/to/pinglet/logs/launchd-healthcheck.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/pinglet/logs/launchd-healthcheck.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
